{
  "components": {
    "schemas": {
      "AppliedSchedule": {
        "properties": {
          "crons": {
            "description": "The non-empty list recorded from the instance's `CronWorkflow`.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "origin": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ScheduleOrigin",
                "description": "Where the applied schedule came from; absent when unrecorded or unknown."
              }
            ]
          },
          "suspended": {
            "description": "Whether the recorded `CronWorkflow` is suspended.",
            "type": "boolean"
          },
          "timezone": {
            "description": "Absent when the `CronWorkflow` uses the Argo controller's timezone.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "crons",
          "suspended"
        ],
        "type": "object"
      },
      "ConnectorHealth": {
        "properties": {
          "configured": {
            "description": "Present in the newest sealed snapshot of the set the controller manages.",
            "type": "boolean"
          },
          "connector": {
            "type": "string"
          },
          "last_sync": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncFact",
                "description": "Absent for a configured connector that has never synced."
              }
            ]
          },
          "schedule": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AppliedSchedule",
                "description": "Applied schedule recorded on the newest sealed tick. Absent outside its\nconfigured set or when that row records no cron expressions."
              }
            ]
          },
          "source_id": {
            "description": "The installation's own id within that tenant. Absent with `tenant_id`.",
            "type": [
              "string",
              "null"
            ]
          },
          "tenant_id": {
            "description": "Tenant of the installation this row is. Absent together with\n`source_id` on history recorded before the ledger carried the identity\nthat no single instance could be shown to own — unattributed, which is a\ndifferent answer from attributed to something named \"\".",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "connector",
          "configured"
        ],
        "type": "object"
      },
      "ConnectorHealthResponse": {
        "properties": {
          "as_of": {
            "description": "When this answer was computed. Dates the answer; `checked_at` dates the\nfacts in it.",
            "type": "string"
          },
          "checked_at": {
            "description": "When the mover was last read. Absent before the first sweep sealed.",
            "type": [
              "string",
              "null"
            ]
          },
          "connectors": {
            "items": {
              "$ref": "#/components/schemas/ConnectorHealth"
            },
            "type": "array"
          },
          "history_available": {
            "description": "False when nothing has been recorded at all, so the page can say so\ninstead of implying health.",
            "type": "boolean"
          },
          "typical_read_interval_ms": {
            "description": "The median gap between the recent sealed ticks. Measured, not\nconfigured — nothing on this path knows what cadence was intended.\nAbsent where too few ticks are recorded to establish one.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "as_of",
          "history_available",
          "connectors"
        ],
        "type": "object"
      },
      "Grain": {
        "description": "Bucket width. The set is closed and validated server-side: the view is a\n`merge()` over every bronze database, so an operator-supplied interval\nexpression would be a direct route into that scan.",
        "enum": [
          "15m",
          "1s"
        ],
        "type": "string"
      },
      "IngestionIntensityResponse": {
        "properties": {
          "from": {
            "type": "string"
          },
          "grain": {
            "$ref": "#/components/schemas/Grain",
            "description": "Echoed resolved, not as asked: the caller may have pinned neither bound."
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/IngestionPoint"
            },
            "type": "array"
          },
          "scope": {
            "description": "The `source_database` the read was scoped to; absent when org-wide.",
            "type": [
              "string",
              "null"
            ]
          },
          "series": {
            "$ref": "#/components/schemas/Series"
          },
          "to": {
            "type": "string"
          },
          "truncated": {
            "description": "The group cap clipped the tail: the window is too wide for this grain\nand series to plot honestly. Never silently true — the UI says so.",
            "type": "boolean"
          }
        },
        "required": [
          "grain",
          "series",
          "from",
          "to",
          "truncated",
          "points"
        ],
        "type": "object"
      },
      "IngestionPoint": {
        "properties": {
          "bucket": {
            "description": "Bucket start as `YYYY-MM-DD HH:MM:SS`, always UTC — the reader's own\nzone would re-cut buckets the server already decided.",
            "type": "string"
          },
          "key": {
            "description": "Connector slug, stream name, or `all`, per the resolved `series`.",
            "type": "string"
          },
          "rows": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "bucket",
          "key",
          "rows"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem+json. `context` varies by error category.",
        "properties": {
          "context": {
            "type": "object"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "context"
        ],
        "type": "object"
      },
      "ScheduleOrigin": {
        "enum": [
          "annotation",
          "descriptor",
          "default"
        ],
        "type": "string"
      },
      "Series": {
        "description": "What one plotted band counts. `Total` exists because the full-period trend\nplots a single line: grouping it by connector would multiply 400 days of\n15-minute buckets by the connector count for a series the chart then sums\nback down anyway.",
        "enum": [
          "connector",
          "stream",
          "total"
        ],
        "type": "string"
      },
      "SyncFact": {
        "properties": {
          "duration_ms": {
            "description": "Absent for a job still in flight, and for one the mover gave no usable\npair of stamps for. Never zero to mean absent.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "job_id": {
            "description": "The mover's own job identity.",
            "type": "string"
          },
          "records_reported": {
            "description": "What the mover states it moved. Absent where it reported no count at\nall, which is a different answer from a reported zero.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "started_at": {
            "description": "Absent for a job the mover had not started.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "The mover's own word for how the sync ended, or `unknown` where the\nrecorded word was outside its documented vocabulary.",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "type": "object"
      },
      "SyncHistoryResponse": {
        "properties": {
          "connector": {
            "type": "string"
          },
          "source_id": {
            "description": "The installation's own id within that tenant. Absent with `tenant_id`.",
            "type": [
              "string",
              "null"
            ]
          },
          "syncs": {
            "description": "A bounded window, newest first — not the full retained history.",
            "items": {
              "$ref": "#/components/schemas/SyncFact"
            },
            "type": "array"
          },
          "tenant_id": {
            "description": "Tenant of the installation the window was narrowed to, echoed back.\nAbsent where the caller asked for the connector rather than one\ninstallation of it, in which case the window spans every instance under\nthat name.",
            "type": [
              "string",
              "null"
            ]
          },
          "window": {
            "description": "How many rows this window holds at most, so the page can say the list\nis a window rather than everything.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "connector",
          "syncs",
          "window"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "internalToken": {
        "description": "Platform-plane workload credential, validated by the receiving listener",
        "in": "header",
        "name": "x-toolkit-internal-token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Connector management service. Mounted at /api/connectors.",
    "title": "Connectors API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/connector-health": {
      "get": {
        "operationId": "analytics_api.connector_health.summary",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorHealthResponse"
                }
              }
            },
            "description": "One row per connector, ordered by what needs acting on"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Recorded sync state of every connector"
      }
    },
    "/v1/connector-health/{connector}/syncs": {
      "get": {
        "operationId": "analytics_api.connector_health.syncs",
        "parameters": [
          {
            "description": "Connector name, as the descriptors spell it",
            "in": "path",
            "name": "connector",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Tenant of one installation of the connector. Required alongside source_id; omit both to span every installation",
            "in": "query",
            "name": "tenant_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Source id of one installation, as its Secret annotates it. Required alongside tenant_id",
            "in": "query",
            "name": "source_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncHistoryResponse"
                }
              }
            },
            "description": "A bounded window of recorded syncs"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Recent syncs of one connector, newest first"
      }
    },
    "/v1/ingestion/intensity": {
      "get": {
        "operationId": "analytics_api.ingestion.intensity",
        "parameters": [
          {
            "description": "Bucket width: 15m or 1s",
            "in": "query",
            "name": "grain",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Bronze database to scope to, e.g. bronze_bamboohr",
            "in": "query",
            "name": "scope",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "What one band counts: connector, stream or total",
            "in": "query",
            "name": "series",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Inclusive lower bound, RFC 3339",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Exclusive upper bound, RFC 3339",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionIntensityResponse"
                }
              }
            },
            "description": "Extraction intensity buckets"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Bronze extraction intensity per bucket"
      }
    }
  },
  "x-toolkit-spec-scope": "minimum-conformance"
}
