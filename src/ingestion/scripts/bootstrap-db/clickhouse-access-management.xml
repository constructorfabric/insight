<?xml version="1.0"?>
<!--
  Enables access_management for the `insight` admin so presentation-role.sql can
  provision presentation_ro (#1963). The official image sets it to 0 in
  users.d/default-user.xml, so mount this under a name sorting AFTER it:
    -v "$PWD/clickhouse-access-management.xml":/etc/clickhouse-server/users.d/zz-access-management.xml:ro
  Not needed in production (the bitnami admin already has it).
-->
<clickhouse>
  <users>
    <insight>
      <access_management>1</access_management>
    </insight>
  </users>
</clickhouse>
