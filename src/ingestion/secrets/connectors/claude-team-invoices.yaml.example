apiVersion: v1
kind: Secret
metadata:
  name: insight-claude-team-invoices-main
  labels:
    app.kubernetes.io/part-of: insight
  annotations:
    insight.cyberfabric.com/connector: claude-team-invoices
    insight.cyberfabric.com/source-id: claude-team-invoices-main
type: Opaque
stringData:
  # All three values are the SAME as the claude-team connector's Secret — this
  # connector reaches the same claude.ai organisation through the same proxy,
  # and needs no credential of its own. Copy them from
  # `insight-claude-team-main` rather than obtaining them again.

  # Required — UUID of the claude.ai organisation. It doubles as the Stripe
  # customer id in the invoices path, so the same value serves both.
  claude_org_id: "CHANGE_ME"

  # Required — base URL of the customer-deployed claude-team-proxy. Invoices are
  # reached through its /api/* passthrough; no proxy change is needed.
  proxy_url: "https://claude-team-proxy.customer.example.com"

  # Required — bearer token the proxy expects. Must match PROXY_AUTH_TOKEN on
  # the proxy container.
  proxy_auth_token: "CHANGE_ME"

  # NOTE: the session key on the proxy must be permitted to read billing. The
  # same cookie that answers overage_spend_limits answers the invoice list; if
  # it is not, the connector's `check` fails with an explicit message rather
  # than syncing an empty stream.

  # NOTE: this connector also needs egress to invoicedata.stripe.com and
  # api.stripe.com. `check` probes the latter and fails if it is unreachable,
  # because invoices without line items carry no seat price at all.

  # NOTE: insight_source_id is NOT a stringData field. It is injected from the
  # insight.cyberfabric.com/source-id annotation above.
