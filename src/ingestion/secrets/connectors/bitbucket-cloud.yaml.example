# Secret for the bitbucket-cloud connector. Copy to bitbucket-cloud.yaml, fill
# the values, and apply to the insight namespace. git_proxy_token must equal
# APP__gears__git_cli_proxy__config__proxy_token in the umbrella-composed
# insight-git-cli-proxy-config Secret.
#
# Two ways to authenticate:
#   Workspace Access Token — bitbucket_token is the token, leave
#     bitbucket_username empty.
#   App Password / Personal API Token — bitbucket_token is the password and
#     bitbucket_username is the account email or username.
apiVersion: v1
kind: Secret
metadata:
  name: insight-bitbucket-cloud-main
  labels:
    app.kubernetes.io/part-of: insight
  annotations:
    insight.cyberfabric.com/connector: bitbucket-cloud
    insight.cyberfabric.com/source-id: bitbucket-cloud-main
stringData:
  bitbucket_token: CHANGE_ME
  bitbucket_username: ""
  bitbucket_workspaces: '["acme"]'   # JSON array of workspace slugs
  git_proxy_url: http://insight-git-cli-proxy:8085
  git_proxy_token: CHANGE_ME
  bitbucket_start_date: "2026-01-01"   # nothing older than this is fetched, by any stream
  # Optional, default 30. How far back the four per-pull-request streams
  # (comments, commits, diffstat, activity) re-read. Raise it to cover a
  # backfill on the first run — ~730 for two years — then lower it.
  bitbucket_pr_detail_lookback_days: "30"
