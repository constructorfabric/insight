# Insight platform — docker-compose dev stack.
#
# This file is normally generated by `./dev-compose.sh up` on first run
# (interactive wizard). Hand-editing afterwards is fine. To re-run the
# wizard, delete `.env.compose` and run `./dev-compose.sh up` again.
#
# Loaded by:
#   ./dev-compose.sh up        (`docker compose --env-file=.env.compose`)
#   ./dev-compose.sh build
#   ./dev-compose.sh seed
#
# All values are optional — defaults below match what the script falls
# back to when a key is unset.
# ─────────────────────────────────────────────────────────────────────

# ── Auto-reload ───────────────────────────────────────────────────────
# When true, EVERY backend container wraps its binary in `watchexec`. A
# change to the bind-mounted host binary (touched by dev-compose.sh build)
# triggers SIGTERM + respawn. Unset = bare exec, matching prod.
#
# This is the ONLY switch that causes container processes to restart.
# DO NOT set this in any k8s manifest. Compose-only.
ENABLE_AUTO_RELOAD=true

# ── Frontend mode ────────────────────────────────────────────────────
# How the frontend ships into the stack:
#   dev    : Vite dev server with HMR. src/frontend is bind-mounted.
#            Fastest dev loop; pnpm install runs on first start.
#   built  : nginx + dist/ bind-mounted from host. Run
#            `./dev-compose.sh build frontend` to produce dist/. No HMR.
#   ghcr   : Pull ${FRONTEND_IMAGE} from a registry. No host repo
#            needed.
FRONTEND_MODE=dev

# Override the published image for FRONTEND_MODE=ghcr. Leave blank for
# the default (ghcr.io/constructorfabric/insight-frontend:latest).
FRONTEND_IMAGE=

# ── Auth ───────────────────────────────────────────────────────────────
# Auth always runs via Keycloak: a real Keycloak container (:8085) with a
# login form + the custom claims, against a realm generated per run. The
# gateway ENFORCES the JWT. See deploy/compose/keycloak/README.md.
# (A lingering AUTH_MODE= line here is ignored.)

# ── Backend image overrides (per service) ─────────────────────────────
# When set, that service pulls the named image instead of building
# locally — dev-compose.sh up detects these and skips the corresponding
# host-side build step, and generates an override that drops the bind
# mount for the service.
#
# The bind mount it drops is the host-built BINARY only — the dev config, the
# authn-tls CA and the authenticator's signing key stay mounted, because no
# published image can carry them and a service without them falls back to its
# committed placeholder config (auth off).
#
# Equivalent CLI: `./dev-compose.sh up --from-ghcr=analytics,identity-resolution`
ANALYTICS_IMAGE=
IDENTITY_RESOLUTION_IMAGE=
AUTHENTICATOR_IMAGE=
GATEWAY_IMAGE=

# ── Explaining a metric with an LLM ───────────────────────────────────
# Off by default. Turning it on without a sealing key stops analytics at
# boot rather than accepting keys it cannot store safely.
# Generate one with: openssl rand -base64 32
AI_ASSIST_ENABLED=false
AI_ASSIST_TOKEN_ENCRYPTION_KEY=
AI_ASSIST_MODEL=claude-sonnet-5

# ── Host port mapping ─────────────────────────────────────────────────
# Change these if 8080/8081/8084/8086/3000/3306/8123/6379 are already in use.
# GATEWAY_PORT is the nginx edge (the :8080 entry).
GATEWAY_PORT=8080
ANALYTICS_PORT=8081
# identity-resolution (Rust identity service) — internal port 8082,
# published on host port 8086.
IDENTITY_RESOLUTION_PORT=8086
# authenticator — OIDC login + sessions + cookie-to-JWT exchange (BFF).
AUTHENTICATOR_PORT=8083
FRONTEND_PORT=3000

MARIADB_PORT=3306
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
REDIS_PORT=6379

REDPANDA_KAFKA_PORT=19092
REDPANDA_PROXY_PORT=18082
REDPANDA_SCHEMA_PORT=18081
REDPANDA_ADMIN_PORT=19644

# ── Database mode (local docker vs external) ──────────────────────────
# `false` (default) → dev-compose.sh up activates the `local-mariadb` /
# `local-clickhouse` profile and starts that DB in compose. Service URLs
# resolve to the docker hostnames `mariadb` / `clickhouse`.
#
# `true` → the local DB service is NOT started. Backend services connect
# to the host/port pair below. Must point at a reachable instance.
MARIADB_EXTERNAL=false
CLICKHOUSE_EXTERNAL=false

# Connect host + container-internal port used by backend services. For
# local docker these are the compose service name and the in-container
# port (NOT the host-side mapping above). For external DBs, put the real
# DNS / IP and port.
MARIADB_HOST=mariadb
MARIADB_INTERNAL_PORT=3306
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_INTERNAL_HTTP_PORT=8123
# Database name used by ClickHouse-touching services. The local profile
# bootstraps this DB; for external CH it must already exist.
CLICKHOUSE_DATABASE=insight

# ── Database credentials ──────────────────────────────────────────────
# Per the project convention secrets live in dotenv for local dev.
# They are ONLY for the local stack — change before any shared use.
# MARIADB_ROOT_PASSWORD only applies to the local-mariadb profile.
MARIADB_ROOT_PASSWORD=root-local
MARIADB_USER=insight
MARIADB_PASSWORD=insight-local

CLICKHOUSE_USER=insight
CLICKHOUSE_PASSWORD=insight-local

# ── Seed bookkeeping ──────────────────────────────────────────────────
# Set to `true` by `./dev-compose.sh up` after a successful first-run
# seed so subsequent `up` calls don't re-seed. Set to empty/false to
# force a re-seed on next `up`. `./dev-compose.sh seed` ignores these.
SEEDED_LOCAL_MARIA=
SEEDED_LOCAL_CH=

# ── Tenant / OIDC ─────────────────────────────────────────────────────
# Default tenant for header-less callers (analytics + identity).
# Replace with the UUID present in your persons.insight_tenant_id.
TENANT_DEFAULT_ID=00000000-df51-5b42-9538-d2b56b7ee953

# Full auth (NGINX_BFF): the nginx `gateway` on :8080 is the entry — it does
# auth_request to the authenticator (which logs in against Keycloak), injects the
# gateway JWT, and every downstream service verifies it (no auth_disabled). Drive
# the login flow with curl (/auth/login -> Keycloak -> /auth/callback -> cookie ->
# /api/...), as the step-07 e2e does.
#
# OIDC client the AUTHENTICATOR presents to its IdP (NGINX_BFF: the authenticator
# does the OIDC flow, not the frontend). Usually leave these blank:
# dev-compose.sh then fills in the pre-seeded `insight-authenticator`
# confidential client — no manual value needed. Set them (with
# AUTHENTICATOR_OIDC_ISSUER below) only to point the authenticator at a
# custom/external IdP; non-blank values always win over the defaults.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Authenticator (nginx+auth step 04) ────────────────────────────────
# In compose the authenticator logs in against Keycloak. Login requires the
# person to exist in Identity — seed the DB (./dev-compose.sh seed identity);
# an unknown person is denied (403).
#
# Issuer: LEAVE UNSET. `./dev-compose.sh up` auto-detects the host IP and sets
# AUTHENTICATOR_OIDC_ISSUER to http://<host-ip>:8085/kc/realms/insight — an IP
# the BROWSER reaches without an HTTPS-upgrade (localhost would mean the
# container itself) and the containers reach too. Set it ONLY to pin a
# custom/external IdP (then auto-detect is skipped).
# AUTHENTICATOR_OIDC_ISSUER=https://your-idp.example/realm
# redirect_uri MUST be the origin the BROWSER loads the SPA from, so the
# `__Host-sid` session cookie lands on the SPA's origin (not the authenticator's
# own :8083). FRONTEND_MODE=dev serves the SPA via Vite at :3000 (which proxies
# /auth + /api to the gateway), so the callback rides that origin. If you browse
# the gateway edge instead, use http://localhost:8080/auth/callback.
AUTHENTICATOR_REDIRECT_URI=http://localhost:3000/auth/callback
# Token `iss` = the TLS discovery front (analytics' plugin resolves JWKS over
# https). The browser still reaches the gateway plainly at :8080.
AUTHENTICATOR_GATEWAY_ISSUER=https://authn-tls:8443
AUTHENTICATOR_IDENTITY_URL=http://identity-resolution:8082

# ── Local login identity ──────────────────────────────────────────────
# The Keycloak realm anchors its dev-lead persona on this person, and the
# seeder creates the matching development-team lead in Identity. Keep them
# in sync or re-seed after changing this. See
# src/ingestion/tools/seed/insight_seed/profiles.py.
DEV_USER_EMAIL=dev@company.nonpresent

# ── Frontend security headers ─────────────────────────────────────────
# CSP value passed to nginx (built / ghcr modes). Leave empty unless you
# need to widen the policy for an embedded analytics widget etc.
CSP_REMOTE=

# ── Log level ─────────────────────────────────────────────────────────
# Rust services honour RUST_LOG (env_logger style). info | debug | trace.
RUST_LOG=info

# ── Out-of-scope reminders ────────────────────────────────────────────
# Airbyte and Argo Workflows are NOT in this stack. They need k8s.
# Use the gitops path (cd deploy/gitops && make deploy ENV=local) for
# those — see CONTRIBUTING.md and deploy/gitops/README.md.
