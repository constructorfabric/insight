---
# Sample SHAPE — see
# ../insight-infra/mariadb-creds-sealedsecret.yaml.template for the
# workflow that generates a real, cluster-specific sealed manifest.
#
# `insight-keycloak-config`: bootstrap admin for the Keycloak deployment
# (keys `username`/`password` — keycloakConfig.extraEnv maps the same keys to
# the config-cli login) + one key per env-var placeholder the realm YAML
# references (unless mapped from another Secret via extraEnv). Required only
# when keycloak.deploy / keycloakConfig.enabled. Stage the cleartext manifest
# in your password manager under `insight-local-insight-keycloak-config`,
# then `make seal-secret`.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: insight-keycloak-config
  namespace: insight
spec:
  encryptedData:
    username:                             AgB...
    password:                             AgC...
    INSIGHT_AUTHENTICATOR_CLIENT_SECRET:  AgD...
    INSIGHT_AUTHENTICATOR_REDIRECT_URI:   AgE...
  template:
    metadata:
      name: insight-keycloak-config
      namespace: insight
    type: Opaque
