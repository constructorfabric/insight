##
## environments/local/inventory.yaml
##
## Declarative inventory for this env. Drives `make bootstrap`,
## `make system`, `make seal`, `make deploy`. Fine-grained targets
## (`make bootstrap-*`, `make system-<svc>`, `make seal-secret …`)
## stay available for one-off / rotation operations.
##

# ─── Cluster targeting ─────────────────────────────────────────────────
kubeContext: insight-local    # required. CLI KUBE_CTX=... overrides,
                              # then env var, then this value.
protected: false              # true → `make deploy` requires
                              #   CONFIRM=yes-deploy-<env>

# ─── Namespaces ────────────────────────────────────────────────────────
namespaces:
  services: insight           # L3 app subcharts
  infra:    insight-infra     # L2 shared stateful
  # Controller namespaces accept upstream-chart defaults; uncomment
  # only to override.
  # envoyGateway:  envoy-gateway-system
  # certManager:   cert-manager
  # sealedSecrets: kube-system

# ─── L3 helm release ───────────────────────────────────────────────────
release: insight

# ─── L0 — cluster prereqs (drives `make bootstrap`) ────────────────────
bootstrap:
  namespaces:    true
  envoyGateway:  true
  certManager:   true
  sealedSecrets: true
  # cert-manager's Gateway API shim. Defaults true when omitted; set false on
  # a cluster with no Gateway API CRDs, where the shim would keep the
  # controller from starting.
  # certManagerGatewayShim: true

# ─── L2 — shared infra (drives `make system`) ──────────────────────────
system:
  mariadb:         true
  clickhouse:      true
  redis:           true
  redpanda:        true
  redpandaConsole: false
  airbyte:         true
  argoWorkflows:   true
  # Observability (LGTM). Off for local dev — flip on to self-host
  # VictoriaMetrics/Loki/Tempo/Alloy/Grafana, and point the umbrella's
  # observability.otlp.endpoint (environments/<env>/values.yaml) at this
  # stack's Alloy. See system/README.md "Observability".
  victoriametrics: false
  loki:            false
  tempo:           false
  alloy:           false
  grafana:         false

# ─── Secrets (drives `make seal`) ──────────────────────────────────────
secrets:
  infra:
    - { name: mariadb-creds,    enabled: true }
    - { name: clickhouse-creds, enabled: true }
    - { name: redis-creds,      enabled: true }
  services:
    - { name: insight-db-creds,                  enabled: true  }
    # ES256 gateway-JWT signing key (current.pem) mounted by the authenticator.
    - { name: insight-authenticator-signing-keys, enabled: true }
    # Real-IdP OIDC secret. Off for local — the authenticator logs in against the
    # in-cluster Keycloak; its leaf config is composed at deploy time by
    # compose-app-secrets.sh, not sealed here.
    - { name: insight-oidc,                      enabled: false }
    # config-cli login + realm placeholder values (ADR-0003 broker realms).
    # Off until keycloakConfig.enabled=true in the umbrella values.
    - { name: insight-keycloak-config,           enabled: false }
