# Local infrastructure coordinates for the prod stand — NOT committed.
#
# These are the cluster's raw IP addresses. They are consumed by the Makefile
# (the wrong-cluster guard reads APISERVER; the Envoy Gateway apply reads
# EDGE_LB_IP) and by nothing inside the cluster, so they cannot live in a
# Kubernetes Secret — they live here instead, outside the repository.
#
# Copy this file to `secrets.local.env` (gitignored via `secrets.local.*`) and
# fill in the real values for your stand. The Makefile sources it automatically;
# a missing or empty value makes `make kube-ctx` / `make bootstrap-envoy-gateway`
# fail with an explicit message rather than acting on the wrong cluster.
#
# Plain KEY=value only — no quotes, no `export`, no inline comments on the value
# lines (the Makefile sources this with the shell).

# The API server URL the wrong-cluster guard compares the live context against.
APISERVER=https://APISERVER_HOST:6443

# The pinned OpenStack floating IP for the Envoy Gateway Service. Use `auto`
# on a brand-new stand to let the cloud controller allocate one (the
# loadBalancerIP line is dropped from the applied manifest); then pin the
# address it hands back here.
EDGE_LB_IP=EDGE_FLOATING_IP
