# Plain credentials for the prod stand — the INPUT to `./seal-secrets.sh`.
#
# Copy to `secrets.plain.env` (gitignored by the `*.env` rule) and fill in.
# Never commit the filled copy: the sealed manifests under sealed-secrets/ are
# the only safe-to-commit representation.
#
# Why one file rather than sealing each secret by hand: several of these values
# must be IDENTICAL in more than one Kubernetes Secret, and nothing at deploy
# time checks that they agree. A datastore password sealed into its own
# namespace but not into insight-db-creds leaves the stand authenticating
# against itself with two different strings, and the failure surfaces as a
# connection error far from the edit. Sealing every copy from one variable is
# what keeps them in step.
#
# Plain KEY=value only, no `export`, no inline comments on value lines. Delete
# a line to leave that secret untouched; the script seals only what is set.
#
# The file is sourced by the shell, which strips one level of quoting. A value
# that must ITSELF contain quotes — the JSON organization lists below — has to
# be wrapped in single quotes, or the connector receives [org] instead of
# ["org"] and reads nothing while reporting success.

# ── Datastore passwords ───────────────────────────────────────────────────
# Each is sealed TWICE: once into its own namespace for the operator that
# creates the database, and once into insight-db-creds for the services that
# connect to it.
CLICKHOUSE_INSIGHT_PASSWORD=
CLICKHOUSE_DEFAULT_PASSWORD=
MARIADB_INSIGHT_PASSWORD=
MARIADB_ROOT_PASSWORD=
REDIS_PASSWORD=

# ── Keycloak ──────────────────────────────────────────────────────────────
# The admin account, sealed into insight-keycloak-admin and into the config
# Job's own Secret. Generated once and reused — rotating it means updating
# Keycloak itself, not just this file.
KEYCLOAK_USER=
KEYCLOAK_PASSWORD=

# The confidential client secret Keycloak issues for insight-authenticator.
# Sealed into insight-oidc (what the authenticator reads) and into
# insight-keycloak-config (what the realm import writes). They must match or
# every login fails at the token exchange.
AUTHENTICATOR_CLIENT_SECRET=

# ── GitHub sign-in (identity broker) ──────────────────────────────────────
# The OAuth App or GitHub App that Keycloak brokers logins through. Sealed
# into github-oauth and insight-keycloak-config.
#
# The App's Authorization callback URL must be the broker endpoint:
#   https://<edge host>/kc/realms/insight-broker/broker/github/endpoint
# A GitHub App additionally needs Account permissions -> Email addresses: Read,
# or the first login has no e-mail address to key the person on.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Connector credentials ─────────────────────────────────────────────────
# github-directory: the roster connector.
GITHUB_DIRECTORY_TOKEN=
GITHUB_DIRECTORY_ORGANIZATIONS='["example-org"]'

# github: the commit/PR connector. Organizations is a JSON array of logins,
# e.g. ["example-org"]. Start date is YYYY-MM-DD.
GITHUB_TOKEN=
GITHUB_ORGANIZATIONS='["example-org"]'
GITHUB_START_DATE=

# The git-cli-proxy address and bearer token. The address MUST be the fully
# qualified Service name: Airbyte runs each connector job in its own namespace,
# where a bare Service name does not resolve.
GIT_PROXY_URL=http://insight-git-cli-proxy.insight.svc.cluster.local:8084
# Must equal APP__gears__git_cli_proxy__config__proxy_token in the
# chart-composed insight-git-cli-proxy-config Secret. Read it from the cluster
# rather than inventing one, or every git sync fails to authenticate.
GIT_PROXY_TOKEN=

# ── Not sealed from here ──────────────────────────────────────────────────
# insight-authenticator-signing-keys (current.pem) is deliberately absent.
# It is an ES256 private key minted once; regenerating it invalidates every
# issued session. Seal it by hand if it ever genuinely needs to change.
